# Use the self-hosted shared-budget provider instead of browser localStorage.
VITE_BUDGET_PERSISTENCE_MODE=shared-server

# Leave empty when the web app and API are served from the same origin.
# During Vite development, /api is proxied to http://127.0.0.1:3000.
VITE_BUDGET_API_URL=

# Persistence modes:
# local-database (default, authoritative and offline)
# browser-local-storage (legacy rollback)
# shared-server (legacy server-authoritative mode)
# VITE_BUDGET_PERSISTENCE_MODE=local-database
