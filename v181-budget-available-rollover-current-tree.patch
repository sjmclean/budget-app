@@ -0,0 +1,114 @@
+import assert from "node:assert/strict";
+
+import { createBudgetViewService } from "../apps/web/src/features/budget/budgetViewService.js";
+import type { BudgetActivityPersistencePort } from "../apps/web/src/features/budget/budgetActivityPersistencePort.js";
+import type { KeyValueStoragePort } from "../apps/web/src/features/persistence/keyValueStoragePort.js";
+
+const BUDGET_ID = "household";
+const MONTH = "2026-06";
+const STORAGE_KEY = `budget-app.budget-view.v1.${BUDGET_ID}.${MONTH}`;
+
+function createMemoryStorage(): KeyValueStoragePort {
+  const values = new Map<string, string>();
+  return {
+    getItem(key: string): string | null {
+      return values.get(key) ?? null;
+    },
+    setItem(key: string, value: string): void {
+      values.set(key, value);
+    },
+    removeItem(key: string): void {
+      values.delete(key);
+    },
+  };
+}
+
+const emptyActivity: BudgetActivityPersistencePort = {
+  async listRegisterTransactionsForBudgetActivity() {
+    return [];
+  },
+  async countCategoryReferences() {
+    return {
+      registerTransactionCount: 0,
+      registerSplitLineCount: 0,
+      scheduledTransactionCount: 0,
+    };
+  },
+  async renameRegisterCategoryReferences() {},
+  async rewriteCategoryReferences() {},
+};
+
+function writeBudgetView(storage: KeyValueStoragePort, category: Record<string, unknown>): void {
+  storage.setItem(
+    STORAGE_KEY,
+    JSON.stringify({
+      budgetId: BUDGET_ID,
+      budgetName: "Household Budget",
+      monthLabel: "June 2026",
+      currencyCode: "AUD",
+      readyToAssign: 0,
+      totalAssigned: 0,
+      totalActivity: 0,
+      totalAvailable: 0,
+      categoryGroups: [
+        {
+          id: "main-expenses",
+          name: "Main Expenses",
+          assigned: 0,
+          activity: 0,
+          available: 0,
+          note: "",
+          categories: [
+            {
+              id: "groceries",
+              name: "Groceries",
+              previousAvailable: 125,
+              assigned: 50,
+              activity: 0,
+              available: 999,
+              isOverspent: false,
+              isArchived: false,
+              note: "",
+              ...category,
+            },
+          ],
+        },
+      ],
+    }),
+  );
+}
+
+async function validatesPreviousAvailableInRuntimeRecalculation(): Promise<void> {
+  const storage = createMemoryStorage();
+  writeBudgetView(storage, {});
+
+  const service = createBudgetViewService({ storage, budgetActivity: emptyActivity });
+  const view = await service.getBudgetMonthView({ budgetId: BUDGET_ID, month: MONTH });
+  const category = view.categoryGroups[0]?.categories[0];
+
+  assert.equal(category?.previousAvailable, 125, "previous available should be preserved on load");
+  assert.equal(category?.available, 175, "available should include previous available plus assigned plus activity");
+  assert.equal(view.totalAvailable, 175, "budget total available should include previous available");
+
+  const updated = await service.updateAssigned({ budgetId: BUDGET_ID, month: MONTH, categoryId: "groceries", assigned: 75 });
+  const updatedCategory = updated.categoryGroups[0]?.categories[0];
+  assert.equal(updatedCategory?.previousAvailable, 125, "previous available should survive assigned edits");
+  assert.equal(updatedCategory?.available, 200, "assigned edits should recalculate using previous available");
+}
+
+async function defaultsLegacyStoredMonthsToZeroPreviousAvailable(): Promise<void> {
+  const storage = createMemoryStorage();
+  writeBudgetView(storage, { previousAvailable: undefined, assigned: 50, activity: 0, available: 50 });
+
+  const service = createBudgetViewService({ storage, budgetActivity: emptyActivity });
+  const view = await service.getBudgetMonthView({ budgetId: BUDGET_ID, month: MONTH });
+  const category = view.categoryGroups[0]?.categories[0];
+
+  assert.equal(category?.previousAvailable, 0, "legacy budget views should default previous available to zero");
+  assert.equal(category?.available, 50, "legacy views should keep existing assigned plus activity behaviour by default");
+}
+
+await validatesPreviousAvailableInRuntimeRecalculation();
+await defaultsLegacyStoredMonthsToZeroPreviousAvailable();
+
+console.log("v1.81 budget available rollover validation passed");
