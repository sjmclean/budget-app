+
+        if (category.id === sourceCategoryId) {
+          return {
+            ...category,
+            assigned: 0,
+            isArchived: true,
+          };
+        }
+
+        return category;
+      }),
+    }));
+
+    return saveBudgetView(
+      {
+        ...current,
+        categoryGroups: nextGroups,
