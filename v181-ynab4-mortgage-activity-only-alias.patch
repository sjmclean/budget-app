+function buildBudgetActivityCanonicalCategoryMap(
+  templateGroups: BudgetCategoryGroupView[],
+  maps: ImportMaps,
+): Map<string, string> {
+  const activeCategoryIdsByName = new Map<string, Set<string>>();
+
+  for (const group of templateGroups) {
+    for (const category of group.categories) {
+      if (category.isArchived) continue;
+      const key = normaliseCategoryStateName(category.name);
+      const ids = activeCategoryIdsByName.get(key) ?? new Set<string>();
+      ids.add(category.id);
+      activeCategoryIdsByName.set(key, ids);
+    }
+  }
+
+  const canonicalById = new Map<string, string>();
+  for (const [categoryId, categoryName] of maps.categoryNameById.entries()) {
+    if (!maps.categoryIsArchivedById.get(categoryId)) continue;
+    const normalisedCategoryName = normaliseCategoryStateName(categoryName);
+    const activeIds = activeCategoryIdsByName.get(normalisedCategoryName);
+    if (activeIds && activeIds.size === 1) {
+      const [canonicalId] = [...activeIds];
+      if (canonicalId && canonicalId !== categoryId) {
+        canonicalById.set(categoryId, canonicalId);
+        continue;
+      }
+    }
+
+    if (normalisedCategoryName === "mortgage") {
+      const canonicalMortgageId = findSingleActiveMortgageCategoryId(activeCategoryIdsByName);
+      if (canonicalMortgageId && canonicalMortgageId !== categoryId) {
+        canonicalById.set(categoryId, canonicalMortgageId);
+      }
+    }
+  }
+
+  return canonicalById;
+}
+
+function findSingleActiveMortgageCategoryId(activeCategoryIdsByName: Map<string, Set<string>>): string | null {
+  const matches = [...activeCategoryIdsByName.entries()]
+    .filter(([categoryName]) => categoryName === "mortgage" || categoryName.startsWith("mortgage "))
+    .flatMap(([, categoryIds]) => [...categoryIds]);
+
+  return matches.length === 1 ? matches[0] ?? null : null;
+}
